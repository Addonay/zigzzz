// Windows resources: the application icon and the File Properties details.

#include <winver.h>

1 ICON "../icons/zigzzz.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0, 1, 1, 0
PRODUCTVERSION  0, 1, 1, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Addonay"
            VALUE "FileDescription",  "Workspace"
            VALUE "FileVersion",      "0.1.1"
            VALUE "InternalName",     "zigzzz"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Addonay. All rights reserved."
            VALUE "OriginalFilename", "zigzzz.exe"
            VALUE "ProductName",      "zigzzz"
            VALUE "ProductVersion",   "0.1.1"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
