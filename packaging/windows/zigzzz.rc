// Windows resources: the application icon shown by Explorer and the
// taskbar, and the version details shown under File Properties.

#include <winver.h>

1 ICON "../icons/zigzzz.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0, 1, 0, 0
PRODUCTVERSION  0, 1, 0, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Addonay"
            VALUE "FileDescription",  "Workspace — QoS KPI charts and KML generation"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "zigzzz"
            VALUE "OriginalFilename", "zigzzz.exe"
            VALUE "ProductName",      "Workspace"
            VALUE "ProductVersion",   "0.1.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
